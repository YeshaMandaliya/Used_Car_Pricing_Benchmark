df = df[(df.year >= 1997) & (df.year <= 2020)]
df["model"] = df.model.str.strip()
df["make_model"] = df.manufacturer + " " + df.model
df["age"] = 2020 - df.year
df["engine_size"] = df.engine_size.replace(0, np.nan)
df.loc[(df.mpg < 10) | (df.mpg > 150), "mpg"] = np.nan
df["transmission"] = df.transmission.replace("Other", np.nan)
df["fuel"] = df.fuel_type.replace({"Electric": "Other"})
print(len(df))

med = df.groupby(["make_model", "year"])["price"].transform("median")
cnt = df.groupby(["make_model", "year"])["price"].transform("size")
ratio = df.price / med
df[(cnt >= 30) & ((ratio > 3) | (ratio < 0.3))].sort_values("price", ascending=False)

df.loc[(df.manufacturer == "Mercedes-Benz") & (df.model == "A Class") & (df.engine_size == 4.0),
       "make_model"] = "Mercedes-Benz A Class AMG"

bad = ((df.price == 123456)
       | ((df.manufacturer == "Hyundai") & (df.price == 92000))
       | ((df.manufacturer == "Vauxhall") & (df.price == df.mileage))
       | ((df.manufacturer == "Skoda") & (df.model == "Karoq") & (df.price > 90000)))
print(bad.sum())
df = df[~bad]

carid = df.groupby(["manufacturer", "model", "year", "transmission", "mileage",
                    "fuel_type", "tax", "mpg", "engine_size"], dropna=False).ngroup()

np.random.seed(0)
ids = carid.unique()
test_ids = np.random.choice(ids, int(0.2 * len(ids)), replace=False)
df["split"] = np.where(carid.isin(test_ids), "test", "train")
print(df.split.value_counts())

df.groupby("split")[["price", "age", "mileage"]].median()

df["ageband"] = pd.cut(df.age, [-1, 2, 5, 10, 100], labels=["0-2", "3-5", "6-10", "11+"])

train = df[df.split == "train"]
test = df[df.split == "test"]

def mape(actual, pred):
    err = np.abs(pred - actual) / actual * 100
    print("MAE ", round(np.mean(np.abs(pred - actual)), 1))
    print("MdAPE", round(np.median(err), 2))
    print("within 10%", round((err <= 10).mean() * 100, 1))
    print("within 20%", round((err <= 20).mean() * 100, 1))

lookup = train.groupby(["make_model", "ageband"], observed=True)["price"].median()
pred = test.set_index(["make_model", "ageband"]).index.map(lookup)
pred = pd.Series(pred, index=test.index)
pred = pred.fillna(test.manufacturer.map(train.groupby("manufacturer").price.median()))
pred = pred.fillna(train.price.median())
print(pred.isna().sum())

mape(test.price, pred)

counts = df.make_model.value_counts()
big = counts[counts >= 100].index
df["grp"] = np.where(df.make_model.isin(big), df.make_model, df.manufacturer + " other")
print(df.grp.nunique())

df["mil"] = df.mileage / 10000
df["age1"] = (df.age - 1).clip(lower=0)
df["age3"] = (df.age - 3).clip(lower=0)
df["age5"] = (df.age - 5).clip(lower=0)
df["age10"] = (df.age - 10).clip(lower=0)
df["mil1"] = (df.mil - 1).clip(lower=0)
df["mil3"] = (df.mil - 3).clip(lower=0)
df["mil6"] = (df.mil - 6).clip(lower=0)
df["mil10"] = (df.mil - 10).clip(lower=0)

d2 = df.dropna(subset=["engine_size", "transmission"])
train = d2[d2.split == "train"]
test = d2[d2.split == "test"]
print(len(train), len(test))

m1 = smf.ols("np.log(price) ~ age + mil + engine_size + C(fuel) + C(transmission) + C(grp)",
             data=train).fit()
print(m1.rsquared)

s = np.mean(np.exp(m1.resid))
p1 = np.exp(m1.predict(test)) * s
mape(test.price, p1)

m2 = smf.ols("np.log(price) ~ age + age1 + age3 + age5 + age10 + mil + mil1 + mil3 + mil6 + mil10"
             " + engine_size + C(fuel) + C(transmission) + C(grp)", data=train).fit()
print(m2.rsquared)

s2 = np.mean(np.exp(m2.resid))
p2 = np.exp(m2.predict(test)) * s2
mape(test.price, p2)

res = test[["manufacturer", "price", "age", "ageband", "mileage"]].copy()
res["pred"] = p2
res["err"] = (res.pred - res.price).abs() / res.price * 100
res["band"] = pd.cut(res.price, [0, 10000, 20000, 30000, 50000, 1e9],
                     labels=["<10k", "10-20k", "20-30k", "30-50k", "50k+"])

res.groupby("band", observed=True)["err"].agg(["size", "median"])

res.groupby("ageband", observed=True)["err"].agg(["size", "median"])

res.groupby("manufacturer")["err"].agg(["size", "median"]).sort_values("median")

b = m2.params
ages = np.arange(0, 16)
idx = np.exp(b["age"] * ages + b["age1"] * np.clip(ages - 1, 0, None)
             + b["age3"] * np.clip(ages - 3, 0, None)
             + b["age5"] * np.clip(ages - 5, 0, None)
             + b["age10"] * np.clip(ages - 10, 0, None))
print(pd.Series((100 * idx).round(1), index=ages))

plt.plot(ages, 100 * idx, marker="o")
plt.xlabel("age")
plt.ylabel("price index, new = 100")
plt.grid(alpha=0.3)
plt.show()

r = test.price / p2
lo = r.quantile(0.05)
hi = r.quantile(0.95)
print(round(lo, 2), round(hi, 2))
print(15000 * lo, 15000 * hi)
